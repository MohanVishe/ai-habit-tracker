# Which backend to use: groq | ollama | openai
LLM_PROVIDER=groq

# Groq - free tier, serves open-weight Llama 3 models
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama - fully local, no API key, nothing leaves the machine
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_SEED=42          # optional fixed sampling seed (eval/run.py sets one)

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Where the SQLite file lives (default data/habits.db)
# HABITLOOP_DB=data/habits.db
