# Which backend to use: groq | ollama | openai
LLM_PROVIDER=groq

# Groq - free tier, serves open-weight Llama 3 models
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama - fully local, no API key, nothing leaves the machine
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
